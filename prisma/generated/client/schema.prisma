generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  publicKey String
  secretKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
